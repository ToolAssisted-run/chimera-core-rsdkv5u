{
  "coreName": "rsdkv5u",
  "systemNames": {
    "SonicOrigins": "Sonic Origins (Sonic 1, Sonic 2, Sonic CD)"
  },
  "systemId": "SonicOrigins",
  "_system_note": "The Retro Engine v5 decompilation built as v5U, the 'Ultimate' engine of Sonic Origins, playing the older games Sonic Origins carries in the engine's legacy modes: Sonic 1 and Sonic 2 (v4) and Sonic CD (v3). Their logic is scripts in their data packs, which the project brings as firmware. Sonic 3 & Knuckles is not played: its logic is a program inside Sonic Origins' own executable.",
  "kind": "game",
  "author": "Evening Star (Retro Engine v5U); the RSDKv5 decompilation by Rubberduckycooly and chuliRMG; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-rsdkv5u",
  "runsOn": [
    "windows-x86_64",
    "linux-x86_64",
    "macos-x86_64",
    "windows-aarch64",
    "linux-aarch64",
    "macos-aarch64"
  ],
  "deterministic": true,
  "_memory_note": "[sbrk, sealed, invisible, plain, mmap] MiB: the engine's own memory (its storage pools for scenes, sprites, sound and the objects) on the heap; the game's data pack in sealed memory, read-only after Init and so in no savestate; SDL's and C++'s larger allocations mmap'd. A savestate of a test game is 5 to 6 MB.",
  "memoryLayoutMiB": [
    256,
    1024,
    4,
    4,
    512
  ],
  "video": {
    "_comment": "What the engine's SDL device draws into its window, with SDL's software renderer: the game's screen, 240 lines and as wide as the Screen Width setting (424 by default).",
    "width": 424,
    "height": 240,
    "virtualWidth": 424,
    "virtualHeight": 240,
    "vsyncNumerator": 60,
    "vsyncDenominator": 1,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "The engine's own mixer (the music and sound effects the data pack has; Sonic Origins keeps most of its sound outside the packs), run for exactly one sixtieth of a second each frame: 735 stereo samples at 44100 Hz.",
    "rate": 44100,
    "samplesPerFrame": 735,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "input": {
    "name": "Sonic Origins",
    "_comment": "Two players' pads, each the engine's twelve inputs: the directions, A, B, C, X, Y, Z, Start and Select. The games jump with A, B or C and pause with Start; the second pad is the second player (Tails in Sonic 2, and its two-player mode). The engine keeps them as a keyboard's state, one bit a button. Dev Menu is the PC keyboard's Escape, which opens the engine's developer menu; it is there only when the Developer Menu setting is on.",
    "buttons": [
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 A",
      "P1 B",
      "P1 C",
      "P1 X",
      "P1 Y",
      "P1 Z",
      "P1 Start",
      "P1 Select",
      "P2 Up",
      "P2 Down",
      "P2 Left",
      "P2 Right",
      "P2 A",
      "P2 B",
      "P2 C",
      "P2 X",
      "P2 Y",
      "P2 Z",
      "P2 Start",
      "P2 Select",
      "Dev Menu"
    ],
    "mnemonics": {
      "Up": "U",
      "Down": "D",
      "Left": "L",
      "Right": "R",
      "A": "A",
      "B": "B",
      "C": "C",
      "X": "X",
      "Y": "Y",
      "Z": "Z",
      "Start": "S",
      "Select": "s",
      "Dev Menu": "E"
    }
  },
  "settings": [
    {
      "name": "game",
      "display": "setting.game",
      "type": "enum",
      "options": [
        "sonic1",
        "sonic2",
        "soniccd"
      ],
      "default": "sonic1",
      "description": "setting.game.about",
      "optionLabels": {
        "sonic1": "setting.game.option.sonic1",
        "sonic2": "setting.game.option.sonic2",
        "soniccd": "setting.game.option.soniccd"
      }
    },
    {
      "name": "language",
      "display": "setting.language",
      "type": "enum",
      "options": [
        "en",
        "fr",
        "it",
        "de",
        "es",
        "ja",
        "ko",
        "zhs",
        "zh"
      ],
      "default": "en",
      "description": "setting.language.about",
      "optionLabels": {
        "en": "setting.language.option.en",
        "fr": "setting.language.option.fr",
        "it": "setting.language.option.it",
        "de": "setting.language.option.de",
        "es": "setting.language.option.es",
        "ja": "setting.language.option.ja",
        "ko": "setting.language.option.ko",
        "zhs": "setting.language.option.zhs",
        "zh": "setting.language.option.zh"
      }
    },
    {
      "name": "screenWidth",
      "display": "setting.screenwidth",
      "type": "int",
      "default": 424,
      "min": 320,
      "max": 424,
      "description": "setting.screenwidth.about"
    },
    {
      "name": "plus",
      "display": "setting.plus",
      "type": "bool",
      "default": false,
      "description": "setting.plus.origins_about"
    },
    {
      "name": "randomSeed",
      "display": "setting.randomseed",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2147483647,
      "description": "setting.randomseed.about"
    },
    {
      "name": "devMenu",
      "display": "setting.devmenu",
      "type": "bool",
      "default": false,
      "description": "setting.devmenu.legacy_about"
    }
  ],
  "firmware": [
    {
      "id": "Sonic1u.rsdk",
      "display": "firmware.sonic1u_rsdk",
      "description": "firmware.sonic1u_rsdk.about",
      "name": "Sonic1u.rsdk",
      "requiredWhen": {
        "setting": "game",
        "is": "sonic1"
      }
    },
    {
      "id": "Sonic2u.rsdk",
      "display": "firmware.sonic2u_rsdk",
      "description": "firmware.sonic2u_rsdk.about",
      "name": "Sonic2u.rsdk",
      "requiredWhen": {
        "setting": "game",
        "is": "sonic2"
      }
    },
    {
      "id": "SonicCDu.rsdk",
      "display": "firmware.soniccdu_rsdk",
      "description": "firmware.soniccdu_rsdk.about",
      "name": "SonicCDu.rsdk",
      "requiredWhen": {
        "setting": "game",
        "is": "soniccd"
      }
    }
  ]
}
